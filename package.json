{
  "name": "archearc-nexus-studio",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build:web": "cd frontend && npm run build",
    "build:electron": "cd frontend && npm run build",
    "build:electron:win": "cd frontend && set VITE_TARGET=electron && npm run build",
    "start": "npm run build:electron && electron .",
    "start:win": "npm run build:electron:win && electron .",
    "electron:dev": "electron .",
    "dist": "npm run build:electron && electron-builder",
    "dist:win": "npm run build:electron:win && electron-builder --win",
    "dist:mac": "npm run build:electron && electron-builder --mac",
    "dist:linux": "npm run build:electron && electron-builder --linux"
  },
  "build": {
    "appId": "com.archearc.nexus",
    "productName": "ArcheArc Nexus Studio",
    "copyright": "Copyright © 2025 ArcheArc Nexus Studio",
    "directories": {
      "buildResources": "assets",
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ArcheArc Nexus Studio"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}